<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      O app não usa Advertising ID: remove as permissões de ID de publicidade
      (AD_ID e as duas ACCESS_ADSERVICES_*) que o SDK do Firebase Analytics
      injeta no manifest merge (junto da meta-data
      google_analytics_adid_collection_enabled=false em <application>), pra
      a declaração do Play Console ("não usa ID de publicidade") bater com o
      manifesto final.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!--
      Visibilidade de pacotes (Android 11+): só as redes sociais da lista
      curada (domain/redesSociais.ts, HU-01) — é o que a tela de bloqueio
      lista e o que o Service intercepta. Deliberadamente SEM
      QUERY_ALL_PACKAGES (rejeitada/revisão manual da Play Store) e sem a
      consulta MAIN/LAUNCHER, que enxergava todos os apps. Mudou a lista?
      Mude aqui junto (há teste que confere).
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.kwai.video" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.twitter.android" />
        <package android:name="com.instagram.barcelona" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.pinterest" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!--
        O app não usa Advertising ID (sem anúncios, SDK de publicidade nem
        atribuição de campanha): desliga a coleta dele pelo Firebase
        Analytics. A lib do Analytics já declara essa chave como true, por
        isso o tools:replace. As permissões são removidas no topo do arquivo.
      -->
      <meta-data
        android:name="google_analytics_adid_collection_enabled"
        android:value="false"
        tools:replace="android:value" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        InterceptActivity (Etapa 4 da spec 09-ponte-fuga-tarefa) — root
        separado ('Intercept'), iniciada só internamente pelo
        RootoraAccessibilityService (exported="false"). Sem singleTask: cada
        detecção abre uma instância nova, com o estado (inclusive sessão
        ativa) vindo pronto via Intent extras — ver InterceptActivity.kt.
        excludeFromRecents evita poluir a lista de apps recentes com uma
        tela que existe só pelo tempo de uma decisão.
      -->
      <activity
        android:name=".InterceptActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:windowSoftInputMode="adjustResize"
        android:excludeFromRecents="true"
        android:exported="false" />

      <service
        android:name=".RootoraAccessibilityService"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
        android:exported="false">
        <intent-filter>
          <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent-filter>
        <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/accessibility_service_config" />
      </service>
    </application>
</manifest>
