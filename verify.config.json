{
  "testCommand": "JEST_JUNIT_OUTPUT_DIR=reports/junit npx jest --ci --reporters=default --reporters=jest-junit",
  "junitReports": "reports/junit/*.xml",
  "criteriaTag": "CA-\\d+",
  "formatCommand": "npx --no-install prettier --write {file} && npx --no-install eslint --fix {file}",
  "formatExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "json"
  ],
  "approvedDeps": [
    "react@19.2.3",
    "react-native@0.87.0",
    "@react-native-firebase/app@26.4.0",
    "@react-native-firebase/auth@26.4.0",
    "@react-native-firebase/firestore@26.4.0",
    "@react-native-firebase/messaging@26.4.0",
    "@react-native-firebase/analytics@26.4.0",
    "@react-native-firebase/crashlytics@26.4.0",
    "@react-native-google-signin/google-signin@16.1.5",
    "@react-navigation/native@7.3.18",
    "@react-navigation/native-stack@7.18.10",
    "@react-navigation/bottom-tabs@7.18.18",
    "react-native-screens@4.27.0",
    "react-native-safe-area-context@5.9.0",
    "react-native-svg@15.15.5",
    "@react-native-async-storage/async-storage@3.1.1",
    "@notifee/react-native@9.1.8",
    "@react-native-community/datetimepicker@9.2.1",
    "lucide-react-native@1.43.0",
    "@react-native-community/cli@20.2.0",
    "@react-native-community/cli-platform-android@20.2.0",
    "@react-native-community/cli-platform-ios@20.2.0",
    "@react-native/babel-preset@0.87.0",
    "@react-native/eslint-config@0.87.0",
    "@react-native/jest-preset@0.87.0",
    "@react-native/metro-config@0.87.0",
    "@react-native/new-app-screen@0.87.0",
    "@react-native/typescript-config@0.87.0",
    "@babel/core@7.29.7",
    "@babel/preset-env@7.29.7",
    "@babel/runtime@7.29.7",
    "typescript@6.0.3",
    "jest@29.7.0",
    "jest-junit@17.0.0",
    "@testing-library/react-native@14.0.1",
    "react-test-renderer@19.2.3",
    "@types/jest@29.5.14",
    "@types/react@19.2.18",
    "@types/react-test-renderer@19.1.0",
    "eslint@8.57.1",
    "prettier@2.8.8",
    "firebase-admin@14.3.0"
  ],
  "e2e": {
    "executor": "",
    "command": "",
    "junitReports": "reports/e2e/*.xml",
    "ci": false
  }
}
